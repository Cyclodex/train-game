.DS_Store
node_modules
/dist

# Claude Code local state (worktrees, per-user session settings) stays local,
# but the shared, checked-in config — the SessionStart hook that installs deps
# in web sessions, plus its registration — is re-included so every session gets
# it. Per-user overrides live in .claude/settings.local.json (ignored).
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json

# Brainstorm / visual-companion mockups (Superpowers)
.superpowers

# Test artifacts
/test-results
/playwright-report
/playwright/.cache
/coverage

# Ad-hoc local scenario screenshots (`npm run shot`). PR before/after shots live
# under docs/verify/ and ARE committed; this default scratch dir is not.
/screenshots


# local env files
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.idea
# .vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
