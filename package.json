{
  "name": "vue-train-game",
  "version": "0.3.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:fast": "vitest run --config vitest.fast.config.ts",
    "test:unit:changed": "vitest run --changed origin/master",
    "test:unit:watch": "vitest --config vitest.fast.config.ts",
    "test:unit:watch:full": "vitest",
    "test:unit:profile": "node scripts/test-profile.mjs",
    "test:e2e": "playwright test",
    "shot": "node scripts/shoot.mjs",
    "browsers": "node scripts/install-browsers.mjs",
    "lint": "eslint . --fix",
    "lint:nofix": "eslint .",
    "probe": "node scripts/probe.mjs",
    "frameperf": "node scripts/frameperf.mjs"
  },
  "dependencies": {
    "vue": "3.5.18",
    "vue-facing-decorator": "3.0.4",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.34.0",
    "eslint-plugin-vue": "9.33.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "sass": "1.100.0",
    "typescript": "5.9.2",
    "vite": "6.3.6",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.12"
  }
}
